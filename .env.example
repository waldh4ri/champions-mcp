# champions-mcp v2 configuration (copy to .env; all values are optional)

# --- Server / data ---------------------------------------------------------
# MCP_TRANSPORT=stdio                 # stdio | streamable-http | sse
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8001
# MCP_PORT=8001                       # host-published port (docker compose)
# CHAMPIONS_MCP_DATA_DIR=./data
# CHAMPIONS_MCP_DB=./data/champions.sqlite
# CHAMPIONS_MCP_PULL=0                # set 1 to force a data refresh on restart

# --- Pull step (only used by champions-mcp-pull) ---------------------------
# Roster, movepool and moves/abilities/items reference text come from
# pokechamp.gg; ranked usage stats (both formats, current ladder season) from
# champs.pokedb.tokyo. PokeAPI is used only for the (game-invariant) type chart
# and localized species names.
# CHAMPIONS_MCP_POKECHAMP_BASE=https://pokechamp.gg
# CHAMPIONS_MCP_POKEDB_CONCURRENCY=4      # max in-flight pokedb usage-page requests
# CHAMPIONS_MCP_POKEAPI_BASE=https://pokeapi.co/api/v2
# CHAMPIONS_MCP_CACHE_DB=./data/pull-cache.sqlite
# CHAMPIONS_MCP_HTTP_TIMEOUT=20

# --- Observed builds (pull step; `champions-mcp-pull --skip-builds` to omit) -
# Complete teams people actually brought, so the tools can answer joint
# questions ("what does a Choice Scarf Garchomp run") instead of only marginal
# ones. VGC comes from Limitless tournament teamlists, BSS from the
# champs.pokedb.tokyo ranked-ladder export. Everything is cached, so only new
# events cost a request on later runs.
# Set to 1 to skip the stage on container start (docker-compose -> entrypoint.sh
# passes --skip-builds). The first build is otherwise several minutes.
# CHAMPIONS_MCP_BUILDS_SKIP=0
#
# CHAMPIONS_MCP_LIMITLESS_BASE=https://play.limitlesstcg.com/api
# CHAMPIONS_MCP_POKEDB_BASE=https://champs.pokedb.tokyo
#
# Optional. Unauthenticated access works fine at 50 requests / 5 min, which the
# pull paces itself against; a key only makes a large backfill faster. Request
# one from your Limitless user API settings.
# CHAMPIONS_MCP_LIMITLESS_KEY=
#
# CHAMPIONS_MCP_BUILDS_REGULATIONS=M-C   # comma-separated; older regs are not
#                                        # legal advice for the current one
# CHAMPIONS_MCP_BUILDS_MAX_EVENTS=150    # tournaments per regulation
# CHAMPIONS_MCP_BUILDS_MIN_PLAYERS=16    # tiny events are noise, not evidence
# CHAMPIONS_MCP_BUILDS_HALF_LIFE_DAYS=21 # recency decay on observation weights
#
# pokedb numbers its exports by ladder season (M-1, M-2, …) while legality is
# set by regulation (M-A, M-B, M-C); the mapping is pinned in pull/builds.py
# and can be overridden here if a season straddles a rollover.
# CHAMPIONS_MCP_POKEDB_SEASON_REGS=1:M-A,2:M-A,3:M-A,4:M-B,5:M-B,6:M-C,7:M-C,8:M-C
#
# Complete BSS teams from players' published team reports (構築記事), scraped
# with the observed-team stage (pull/reports.py; cached in <data>/reports-cache).
# Set to 1 to skip just this step.
# CHAMPIONS_MCP_REPORTS_SKIP=0

# --- Damage calculator (champions-calc sidecar) ----------------------------
# CHAMPIONS_MCP_CALC_HTTP=http://champions-calc:3000/   # use HTTP sidecar
# CHAMPIONS_MCP_DOCKER=docker                           # or one-shot docker run
# CHAMPIONS_MCP_CALC_IMAGE=champions-calc:latest
# CHAMPIONS_MCP_CALC_TIMEOUT=30

# --- Battle simulator (champions-sim sidecar) ------------------------------
# CHAMPIONS_MCP_SIM_HTTP=http://champions-sim:3000/     # use HTTP sidecar
# CHAMPIONS_MCP_SIM_IMAGE=champions-sim:latest           # or one-shot docker run
# CHAMPIONS_MCP_SIM_TIMEOUT=300
# CHAMPIONS_MCP_SIM_MAX_BATTLES=20000                    # per tool call
# Sidecar side (docker-compose champions-sim service):
# SIM_WORKERS=0          # 0 = auto: every CPU the container may use, capped by memory
# SIM_MAX_BATTLES=50000  # hard per-request cap

# --- Web chat ----------------------------------------------------------------
# Uncomment to run the web chat with plain `docker compose` commands (the
# alternative to passing --profile to up AND down): webchat = local models on
# CPU + RAM, webchat-gpu = local models on an NVIDIA GPU.
# COMPOSE_PROFILES=webchat
# Chat UI at http://localhost:3000. Most of this is easier in its ⚙ Configure
# view (saved in the chat-data volume, wins over these defaults): local models,
# inference & chat settings, OpenRouter, OpenAI-compatible APIs.
#
# OpenRouter (no GPU needed). The Auto Router at low/medium/high cost tiers is
# always offered; OPENROUTER_MODEL adds fixed models (or add them in Configure).
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash,openai/gpt-6-luna,google/gemini-4-argon
# OPENROUTER_PROVIDER_SORT=price      # cheapest provider first, flex tiers included | throughput | latency | default
# Candidate pools per Auto Router tier (empty = OpenRouter's whole ranking for the band):
# OPENROUTER_AUTO_MODELS=deepseek/deepseek-v4.1-flash,openai/gpt-6-luna   # low
# OPENROUTER_AUTO_MODELS_MEDIUM=
# OPENROUTER_AUTO_MODELS_HIGH=
# Price caps, USD per 1M tokens (also in the Configure view):
# OPENROUTER_MAX_PRICE=1              # input, fixed models + low tier; 0 = no cap
# OPENROUTER_MAX_PRICE_OUTPUT=5       # output, same scope (output usually costs 4-5x input)
# OPENROUTER_MAX_PRICE_MEDIUM=        # medium/high tiers, input and output; empty = no cap
# OPENROUTER_MAX_PRICE_HIGH=
# Per-model provider routing (OpenRouter `provider` object as JSON, keyed by model).
# Replaces the price cap and provider sort for that model. Built-in default (when empty):
# OPENROUTER_MODEL_ROUTES={"google/gemini-4-argon":{"only":["google-ai-studio/flex"],"allow_fallbacks":false,"max_price":{"prompt":1,"completion":5}}}
# OPENROUTER_REASONING_EFFORT=        # low | medium | high (unset: model default)
# OPENROUTER_TEMPERATURE=             # unset: model default
#
# Any OpenAI-compatible API (vLLM, LM Studio, Ollama /v1, a hosted provider).
# From the containers, this machine is host.docker.internal.
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODELS=               # empty = the API's /models list
# OPENAI_COMPAT_NAME=                 # label in the model picker
#
# CHAT_PROVIDER=auto                  # auto (every available backend) | llama | openrouter (only that one)
# Follow-up questions see earlier turns' tool calls and results, not just their
# answers. When a chat outgrows this share of the model's context, the oldest
# tool results are shortened, then the oldest tool chains dropped (answers kept).
# HISTORY_CONTEXT_SHARE=0.5

# --- Local models (llama.cpp) for the web chat ------------------------------
# llama-server runs in router mode: it starts empty; add models in ⚙ Configure →
# Local models (a Hugging Face link: downloaded with its MTP head, loaded on
# first use) or drop .gguf files in ./models. Runs on CPU + RAM with the
# webchat profile, on an NVIDIA GPU with webchat-gpu.
# HF_TOKEN=                      # gated/private Hugging Face repos only
# LLAMA_MODELS_MAX=1             # models loaded at once; picking another unloads it
# LLAMA_CPU_IMAGE=champions-llama-cpu:latest   # image tags of the two variants
# LLAMA_IMAGE=champions-llama:latest
#
# Defaults for ⚙ Configure → Inference (global or per model):
# LLAMA_CTX_SIZE=                # empty = fit the largest context the GPU holds, per model
# LLAMA_CACHE_TYPE_K=q8_0        # KV quant: q8 = half of f16, same quality; q4_0 saves
# LLAMA_CACHE_TYPE_V=q8_0        # more memory at some long-context accuracy cost
# LLAMA_N_GPU_LAYERS=99          # 99 = all layers on the GPU
# LLAMA_N_CPU_MOE=               # MoE models bigger than VRAM: layers whose experts stay
#                                # in RAM. Qwen3.6-35B-A3B on 16 GB / 128k / q8: 18 (~81 t/s)
# LLAMA_FLASH_ATTN=on
# LLAMA_REASONING_BUDGET=2048    # thinking tokens per round; -1 = unlimited, 0 = none
# LLAMA_MTP_ENABLED=1            # speculative decoding with the model's own draft head
#
# Defaults for ⚙ Configure → Chat:
# LLAMA_THINK=true               # reasoning block before answers/tool calls (local models)
# Sampling: unset = Qwen's per-mode profile (thinking 0.6/0.95/20, instruct
# 0.7/0.8/20, min_p 0). Higher temperature buys randomness, not better teams.
# LLAMA_TEMPERATURE=
# LLAMA_TOP_P=
# LLAMA_TOP_K=
# LLAMA_MIN_P=
# LLAMA_PRESENCE_PENALTY=0.5     # mild; discourages re-issuing an identical tool call
# MAX_TOOL_ROUNDS=               # empty = 40 (local) / 80 (1M-context models)
# MAX_TOOL_RESULT_CHARS=         # empty = 16000 (local) / 60000 (1M-context models)
#
# Server-wide (llama-server service):
# LLAMA_PARALLEL=1               # chat = 1 slot
# LLAMA_NO_MMAP=1                # weights read into RAM up front (no mid-token page faults)
# LLAMA_MLOCK=0                  # lock pages vs OS paging (IPC_LOCK cap already set)
# LLAMA_EXTRA_ARGS=              # extra flags for every model (override the Configure view)
# LLAMA_PORT=8080                # host port for llama-server
# WEBUI_PORT=3000                # host port for the chat UI

# --- Logging (every service) ---
# LOG_LEVEL=INFO                # DEBUG adds per-request HTTP/calc detail; WARNING = problems only
# LOG_COLOR=1                   # ANSI colors in `docker compose logs`; 0 = plain text for log shippers
