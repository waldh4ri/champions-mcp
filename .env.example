# champions-mcp v2 configuration (copy to .env; all values are optional)

# --- Server / data ---------------------------------------------------------
# MCP_TRANSPORT=stdio                 # stdio | streamable-http | sse
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8001
# MCP_PORT=8001                       # host-published port (docker compose)
# CHAMPIONS_MCP_DATA_DIR=./data
# CHAMPIONS_MCP_DB=./data/champions.sqlite
# CHAMPIONS_MCP_PULL=0                # set 1 to force a data refresh on restart

# --- Pull step (only used by champions-mcp-pull) ---------------------------
# CHAMPIONS_MCP_SOURCE_BASE=https://championsbattledata.com
# CHAMPIONS_MCP_POKEAPI_BASE=https://pokeapi.co/api/v2
# CHAMPIONS_MCP_CACHE_DB=./data/pull-cache.sqlite
# CHAMPIONS_MCP_HTTP_TIMEOUT=20

# --- Observed builds (pull step; `champions-mcp-pull --skip-builds` to omit) -
# Complete teams people actually brought, so the tools can answer joint
# questions ("what does a Choice Scarf Garchomp run") instead of only marginal
# ones. VGC comes from Limitless tournament teamlists, BSS from the
# champs.pokedb.tokyo ranked-ladder export. Everything is cached, so only new
# events cost a request on later runs.
# Set to 1 to skip the stage on container start (docker-compose -> entrypoint.sh
# passes --skip-builds). The first build is otherwise several minutes.
# CHAMPIONS_MCP_BUILDS_SKIP=0
#
# CHAMPIONS_MCP_LIMITLESS_BASE=https://play.limitlesstcg.com/api
# CHAMPIONS_MCP_POKEDB_BASE=https://champs.pokedb.tokyo
#
# Optional. Unauthenticated access works fine at 50 requests / 5 min, which the
# pull paces itself against; a key only makes a large backfill faster. Request
# one from your Limitless user API settings.
# CHAMPIONS_MCP_LIMITLESS_KEY=
#
# CHAMPIONS_MCP_BUILDS_REGULATIONS=M-C   # comma-separated; older regs are not
#                                        # legal advice for the current one
# CHAMPIONS_MCP_BUILDS_MAX_EVENTS=150    # tournaments per regulation
# CHAMPIONS_MCP_BUILDS_MIN_PLAYERS=16    # tiny events are noise, not evidence
# CHAMPIONS_MCP_BUILDS_HALF_LIFE_DAYS=21 # recency decay on observation weights
#
# pokedb numbers its exports by ladder season (M-1, M-2, …) while legality is
# set by regulation (M-A, M-B, M-C); the mapping is pinned in pull/builds.py
# and can be overridden here if a season straddles a rollover.
# CHAMPIONS_MCP_POKEDB_SEASON_REGS=1:M-A,2:M-A,3:M-A,4:M-B,5:M-C

# --- Damage calculator (champions-calc sidecar) ----------------------------
# CHAMPIONS_MCP_CALC_HTTP=http://champions-calc:3000/   # use HTTP sidecar
# CHAMPIONS_MCP_DOCKER=docker                           # or one-shot docker run
# CHAMPIONS_MCP_CALC_IMAGE=champions-calc:latest
# CHAMPIONS_MCP_CALC_TIMEOUT=30

# --- Local LLM (llama.cpp) + web chat (docker compose --profile ai) --------
# The chat UI talks to llama-server's OpenAI-compatible API. Backend = Qwen3.6-
# 35B-A3B (MoE) at UD-Q4_K_M, expert layers offloaded to CPU. ~86 t/s on 16 GB.
#
# Model source — set ONE (LLAMA_MODEL_HF wins if both are set):
# LLAMA_MODEL_FILE=unsloth_Qwen3.6-35B-A3B-UD-Q4_K_M.gguf     # local GGUF in ./models (default)
# LLAMA_MODEL_HF=unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M  # auto-download from HF (cached)
# LLAMA_MODEL_NAME=qwen3.6-35b-a3b   # alias shown in /v1/models + sent by the chat
# LLAMA_THINK=true               # Qwen reasoning block: false | true. ON by default —
#                                # team building is multi-step tool planning + SP/damage
#                                # arithmetic, which is where thinking pays off. Set false
#                                # for a latency-first setup doing quick lookups only.
# LLAMA_REASONING_BUDGET=2048    # max thinking tokens per round (caps latency when THINK=true).
#                                # -1 = unrestricted, 0 = none, off = omit flag (old builds)
#
# Sampling. Defaults follow Qwen3's published per-mode values, picked from
# LLAMA_THINK: thinking 0.6/0.95/20, non-thinking 0.7/0.8/20 (min_p 0). Leave
# unset unless you know why. Raising temperature does NOT produce more creative
# teams — it produces less reliable facts and more malformed tool calls; team
# creativity comes from the prompt and from searching the roster.
# LLAMA_TEMPERATURE=              # override the per-mode default
# LLAMA_TOP_P=
# LLAMA_TOP_K=
# LLAMA_MIN_P=
# LLAMA_PRESENCE_PENALTY=0.5      # mild; discourages re-issuing an identical tool call
#
# Performance knobs (measured on a 16 GB RTX 4080):
# LLAMA_N_CPU_MOE=18             # experts pinned to CPU (THE key knob), for 128k/q8.
#                                # 18 → ~81 t/s, ~635 MB headroom; 17 OOMs (128k compute
#                                # buffer ~585 MB); 19 → ~78 t/s, ~1.1 GB. At 32k it's 15/~86.
# LLAMA_PARALLEL=1               # chat = 1 slot; frees ~0.5 GB vs the default 4
# LLAMA_N_GPU_LAYERS=99          # attention/non-expert layers on GPU (99 = all)
# LLAMA_CACHE_TYPE_K=q8_0        # KV quant. q8 fits 128k & keeps full quality; q4_0 buys
# LLAMA_CACHE_TYPE_V=q8_0        # ~2-3 t/s (→ n-cpu-moe 16) but degrades long-context accuracy
# LLAMA_CTX_SIZE=131072          # 128k. GQA (2 KV heads) keeps KV cheap (~2.7 GB q8 @ 128k)
# LLAMA_NO_MMAP=1                # force weights resident in RAM (no mid-token page faults)
# LLAMA_MLOCK=0                  # lock pages vs OS paging (IPC_LOCK cap already set)
# Optional MTP/speculative decoding (off by default; can be slower on MoE).
# LLAMA_MTP_ENABLED=0
# LLAMA_MTP_SPEC_TYPE=draft-mtp
# LLAMA_MTP_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M-MTP.gguf
# LLAMA_MTP_MODEL_HF=             # optional draft model from HF (overrides *_MODEL_FILE)
# LLAMA_MTP_DRAFT_MIN=1
# LLAMA_MTP_DRAFT_MAX=8
# LLAMA_MTP_P_MIN=0.50
# LLAMA_MTP_EXTRA_ARGS=         # escape hatch for newer draft flags
# LLAMA_EXTRA_ARGS=             # escape hatch, e.g. "--threads 8 --batch-size 512"
# LLAMA_PORT=8080               # host port for llama-server
# WEBUI_PORT=3000               # host port for the chat UI
# MAX_TOOL_ROUNDS=40            # max tool-call rounds per chat turn. A 6-Pokémon build
#                               # needs ~25 rounds to reach the first damage calc.
# MAX_TOOL_RESULT_CHARS=16000   # cap on a single tool result fed back to the model
#                               # (~4k tokens; 8000 truncated catalogue-style results)
